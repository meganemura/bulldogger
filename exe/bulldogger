#!/usr/bin/env ruby
# frozen_string_literal: true

# This thin adapter answers two questions: the installed version and the
# location of the shipped skill. Bulldogger exposes evidence as files, so
# evidence queries and servers use separate interfaces.

require "bulldogger/skill"
require "bulldogger/version"

usage = "Usage: bulldogger skill path | bulldogger version | bulldogger --version"

case ARGV
when ["skill", "path"]
  path = Bulldogger.skill_path
  if path
    puts path
  else
    warn "bulldogger: the installed skill is unavailable"
    exit 1
  end
when ["version"], ["--version"]
  puts Bulldogger::VERSION
else
  warn usage
  exit 1
end
