#!/usr/bin/env ruby
# frozen_string_literal: true

# This thin adapter routes frame collection and reports the installed version
# or the shipped skill location. Evidence queries and servers use separate
# interfaces because Bulldogger exposes evidence as files.

require "bulldogger/skill"
require "bulldogger/version"

usage = "Usage: bulldogger exec <fid> --line N [--visit K] --statement text [--index path] -- command... | bulldogger flt <fid> [--index path] -- command... | bulldogger frames -- command... | bulldogger preflight -- command... | bulldogger skill path | bulldogger version | bulldogger --version"

def dispatch_command(verb)
  separator = ARGV.index("--")
  raise ArgumentError, "#{verb} requires a command after --" unless separator

  status = yield(ARGV[1], ARGV[2...separator], ARGV.drop(separator + 1))
  exit(status.respond_to?(:exitstatus) ? (status.exitstatus || 1) : status)
rescue ArgumentError => error
  warn "bulldogger: #{error.message}"
  exit 1
end

if ARGV.first == "exec"
  require "bulldogger/exec"
  dispatch_command("exec") do |fid, options, command|
    parsed = {}
    until options.empty?
      name = options.shift
      value = options.shift
      raise ArgumentError, "invalid exec options" unless %w[--line --visit --statement --index].include?(name) && value
      raise ArgumentError, "duplicate exec option #{name}" if parsed.key?(name)
      parsed[name] = value
    end
    raise ArgumentError, "exec requires --line" unless parsed["--line"]
    raise ArgumentError, "exec requires --statement" unless parsed["--statement"]
    Bulldogger::Exec.run(
      fid, command, line: Integer(parsed["--line"], 10),
      visit: Integer(parsed.fetch("--visit", "1"), 10), statement: parsed["--statement"], index: parsed["--index"]
    )
  end
end

if ARGV.first == "flt"
  require "bulldogger/flt"
  dispatch_command("flt") do |fid, options, command|
    index = options.first == "--index" ? options[1] : nil
    raise ArgumentError, "invalid flt options" unless options.empty? || (options.length == 2 && index)

    Bulldogger::Flt.run(fid, command, index: index)
  end
end

if ARGV.first(2) == ["frames", "--"]
  require "bulldogger/frames"
  begin
    status = Bulldogger::Frames.run(ARGV.drop(2))
    exit(status.exitstatus || 1)
  rescue ArgumentError => error
    warn "bulldogger: #{error.message}"
    exit 1
  end
end

if ARGV.first(2) == ["preflight", "--"]
  require "bulldogger/preflight"
  begin
    exit Bulldogger::Preflight.run(ARGV.drop(2))
  rescue ArgumentError => error
    warn "bulldogger: #{error.message}"
    exit 1
  end
end

case ARGV
when ["skill", "path"]
  path = Bulldogger.skill_path
  if path
    puts path
  else
    warn "bulldogger: the installed skill is unavailable"
    exit 1
  end
when ["version"], ["--version"]
  puts Bulldogger::VERSION
else
  warn usage
  exit 1
end
